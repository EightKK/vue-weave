{
  "name": "vue-weave",
  "version": "0.4.0",
  "description": "Composable network graphs and interactive timelines for Vue 3.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EightKK/vue-weave.git"
  },
  "homepage": "https://github.com/EightKK/vue-weave#readme",
  "bugs": {
    "url": "https://github.com/EightKK/vue-weave/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "docs",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./style.css": "./dist/style.css"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts --host 127.0.0.1",
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/finalize-declarations.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "prepare:release": "node scripts/prepare-release.mjs",
    "check": "npm run typecheck && npm test && npm run build:demo",
    "prepack": "npm run build",
    "start": "node scripts/serve.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "~7.0.2",
    "vite": "8.3.7",
    "vue": "3.5.45",
    "vue-tsc": "^3.2.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "graph",
    "network",
    "gantt",
    "timeline",
    "typescript"
  ]
}
